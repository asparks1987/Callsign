{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://callsign.local/schemas/policy-decision.schema.json",
  "title": "Callsign Policy Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "timestamp_utc",
    "tool",
    "decision",
    "risk_tier",
    "reason",
    "rule_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 100
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "tool": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
      "maxLength": 100
    },
    "decision": {
      "enum": [
        "allow",
        "require_approval",
        "deny",
        "handoff"
      ]
    },
    "risk_tier": {
      "enum": [
        "observe",
        "local_reversible",
        "local_state_change",
        "external_side_effect",
        "dangerous_or_blocked"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "rule_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "approval_prompt": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "approval_scope": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "expires_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
