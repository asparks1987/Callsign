<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Callsign-Setup</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Payload\Callsign.UI.exe" LogicalName="Callsign.UI.exe" />
    <EmbeddedResource Include="Payload\fzf.exe" LogicalName="fzf.exe" />
  </ItemGroup>
</Project>
