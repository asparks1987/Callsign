<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Callsign-Setup</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\assets\callsign.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Payload\Callsign.UI.exe" LogicalName="Callsign.UI.exe" />
    <EmbeddedResource Include="Payload\fzf.exe" LogicalName="fzf.exe" />
    <EmbeddedResource Include="Payload\Callsign.Service.exe" LogicalName="Callsign.Service.exe" />
    <EmbeddedResource Include="Payload\callsign.ico" LogicalName="callsign.ico" Condition="Exists('Payload\callsign.ico')" />
    <EmbeddedResource Include="Payload\callsign.onnx" LogicalName="callsign.onnx" Condition="Exists('Payload\callsign.onnx')" />
    <EmbeddedResource Include="Payload\setupopenwakeword.ps1" LogicalName="setupopenwakeword.ps1" Condition="Exists('Payload\setupopenwakeword.ps1')" />
    <EmbeddedResource Include="Payload\testopenwakeword.ps1" LogicalName="testopenwakeword.ps1" Condition="Exists('Payload\testopenwakeword.ps1')" />
    <EmbeddedResource Include="Payload\openwakeword-resources.zip" LogicalName="openwakeword-resources.zip" Condition="Exists('Payload\openwakeword-resources.zip')" />
    <EmbeddedResource Include="Payload\openwakeword-runtime.zip" LogicalName="openwakeword-runtime.zip" Condition="Exists('Payload\openwakeword-runtime.zip')" />
    <EmbeddedResource Include="Payload\python-runtime-win-x64.zip" LogicalName="python-runtime-win-x64.zip" Condition="Exists('Payload\python-runtime-win-x64.zip')" />
    <EmbeddedResource Include="Payload\openwakeword-wheelhouse.zip" LogicalName="openwakeword-wheelhouse.zip" Condition="Exists('Payload\openwakeword-wheelhouse.zip')" />
    <EmbeddedResource Include="Payload\setuppyannote.ps1" LogicalName="setuppyannote.ps1" Condition="Exists('Payload\setuppyannote.ps1')" />
    <EmbeddedResource Include="Payload\testpyannote.ps1" LogicalName="testpyannote.ps1" Condition="Exists('Payload\testpyannote.ps1')" />
    <EmbeddedResource Include="Payload\pyannote-runtime.zip" LogicalName="pyannote-runtime.zip" Condition="Exists('Payload\pyannote-runtime.zip')" />
    <EmbeddedResource Include="Payload\pyannote-wheelhouse.zip" LogicalName="pyannote-wheelhouse.zip" Condition="Exists('Payload\pyannote-wheelhouse.zip')" />
    <EmbeddedResource Include="Payload\pyannote-model-cache.zip" LogicalName="pyannote-model-cache.zip" Condition="Exists('Payload\pyannote-model-cache.zip')" />
    <EmbeddedResource Include="Payload\pyannote_audio-4.0.4.tar.gz" LogicalName="pyannote_audio-4.0.4.tar.gz" Condition="Exists('Payload\pyannote_audio-4.0.4.tar.gz')" />
    <EmbeddedResource Include="Payload\THIRD_PARTY_SOURCES.md" LogicalName="THIRD_PARTY_SOURCES.md" Condition="Exists('Payload\THIRD_PARTY_SOURCES.md')" />
  </ItemGroup>
</Project>
