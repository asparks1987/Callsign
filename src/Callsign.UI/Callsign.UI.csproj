<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Callsign.UI</RootNamespace>
    <ApplicationIcon>..\..\assets\callsign.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\assets\callsign.ico" Link="callsign.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\callsign.gif" LogicalName="callsign.gif" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Callsign.Extensions\Callsign.Extensions.csproj" />
  </ItemGroup>
</Project>
